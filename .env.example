APP_NAME=SIGNAL
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173

# Qwen Multimodal Reasoning (Qwen3-VL / Qwen2.5-VL)
# Leave QWEN_API_KEY blank to use local reasoning & structured event extraction engine
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_DEVICE=auto
QWEN_DTYPE=auto
QWEN_API_BASE_URL=
QWEN_API_KEY=

# YOLO Object Detection & Tracking
YOLO_MODEL_PATH=yolov8n.pt
YOLO_POSE_MODEL_PATH=yolov8n-pose.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_TRACKER=bytetrack.yaml

# Semantic Index (BGE-M3 or local semantic vector fallback)
BGE_MODEL_ID=BAAI/bge-m3
ENABLE_SEMANTIC_SEARCH=true

# Video Pipeline Specs
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=300
FRAME_SAMPLE_FPS=1
ANALYSIS_FRAME_WIDTH=1280

# FFmpeg Binary Path (Leave empty to use system PATH)
FFMPEG_PATH=C:\Users\91810\.antigravity-ide\extensions\kilocode.kilo-code-7.8.3-win32-x64\bin\ffmpeg.exe

# Storage Directories
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
FRAMES_DIR=./data/frames
DB_PATH=./data/signal.sqlite3

MAX_WORKERS=2
